{
  "name": "von-webgpu",
  "version": "1.0.0",
  "description": "Zero-Python System 1 Reflex Engine for wfzyx/von-1.0 over WebGPU & WASM",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./primitives": {
      "import": "./dist/primitives.js",
      "types": "./dist/primitives.d.ts"
    },
    "./cache": {
      "import": "./dist/cache.js",
      "types": "./dist/cache.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "node --test tests/*.test.js || tsx --test tests/*.test.ts",
    "start": "tsx main.ts",
    "export:model": "python export_von.py"
  },
  "keywords": [
    "system-1",
    "webgpu",
    "modernbert",
    "von",
    "onnx",
    "onnxruntime",
    "zero-python",
    "edge-ai",
    "guardrails",
    "classification",
    "browser-ai"
  ],
  "author": "Mushthaq azeez",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/mushthaqazeez/von-webgpu.git"
  },
  "dependencies": {
    "@xenova/transformers": "^2.17.2",
    "onnxruntime-web": "^1.21.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.9",
    "onnxruntime-node": "^1.21.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
