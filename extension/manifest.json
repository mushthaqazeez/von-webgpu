{
  "manifest_version": 3,
  "name": "Mentat — High-Speed Cognitive Browser Pilot",
  "version": "1.1.0",
  "description": "Sub-15ms voice and text browser motor reflexes powered by local on-device Neural Transformer Embeddings.",
  "permissions": [
    "activeTab",
    "storage",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Mentat Browser Pilot (Alt+M)"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["system_two.js", "engine.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "transformers.min.js",
        "system_two.js",
        "*.wasm"
      ],
      "matches": ["<all_urls>"]
    }
  ],
  "commands": {
    "toggle-mentat": {
      "suggested_key": {
        "default": "Alt+M",
        "mac": "Alt+M"
      },
      "description": "Summon Mentat Cognitive Command HUD"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
